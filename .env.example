# Server-side FastAPI address. Set this to the backend URL when deploying.
API_BASE_URL=http://127.0.0.1:8000

# Optional: override API_BASE_URL for owner login and session verification only.
# OWNER_API_URL=http://127.0.0.1:8000

# Required in production; must match OWNER_ALLOWED_ORIGINS in the backend.
# OWNER_SITE_URL=https://www.clearimpressionservices.com
# Vercel Production: API_BASE_URL=https://ci-backend-mnzv.onrender.com

# Optional: URL of the separately running Sanity Studio editing application.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
