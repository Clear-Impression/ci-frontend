# Server-side FastAPI address. Set this to the backend URL when deploying.
API_BASE_URL=http://127.0.0.1:8000

# Optional: override API_BASE_URL for owner login and session verification only.
# OWNER_API_URL=http://127.0.0.1:8000

# Required in production; must match OWNER_ALLOWED_ORIGINS in the backend.
# OWNER_SITE_URL=https://www.clearimpressionservices.com
# Vercel Production: API_BASE_URL=https://ci-backend-mnzv.onrender.com

# Local Studio. For Vercel Production, use the hosted editor:
# NEXT_PUBLIC_SANITY_STUDIO_URL=https://clear-impression-services.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Sanity project used by the public website.
NEXT_PUBLIC_SANITY_PROJECT_ID=vpeebhw5
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: open days for the estimate's "Request a day" step, from Google
# Calendar (read-only free/busy). Without these, Monday to Saturday show open.
# Share the calendar with the service account as "See only free/busy".
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
